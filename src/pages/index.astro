---
import Layout from "../layouts/Layout.astro";

const DECK_BASE =
	"https://docs.google.com/presentation/d/e/2PACX-1vRpjdtg24rsBPwc3FlZcg39QWNcLx2SinTuQ6HcpN-K3czo6iW7JOnHk0oeXIvh0fP4d5GO-g3px-_Q/pubembed";
const AUTOPLAY_DELAY = 10000;

let slideCount = 0;
try {
	const html = await fetch(DECK_BASE).then((res) => res.text());
	slideCount = Number.parseInt(
		html.match(/slidePageCount:\s*([\d.]+)/)?.[1] ?? "0",
		10,
	);
} catch {
	console.warn("Slide count not available – navigation will be hidden.");
}

const slideSrc = (slide: number) =>
	`${DECK_BASE}?start=false&loop=false&rm=minimal&slide=${slide}`;

const navigable = slideCount > 1;
const slides = Array.from({ length: Math.max(slideCount, 1) }, (_, i) => i + 1);

// Jede Folie sitzt auf der Kopie, die der aktuellen Position am nächsten liegt.
// Dadurch ist jeder Slot rund um die Position belegt und nichts muss je
// zurückgesetzt werden – auch nicht mitten in einer laufenden Bewegung.
const slotFor = (slideIndex: number, position = 0) =>
	navigable
		? slideIndex + slideCount * Math.round((position - slideIndex) / slideCount)
		: slideIndex;
---

<Layout title="Sophie Matthes" description="Portfolio of Sophie Matthes.">
	<main
		class:list={["stage", { "is-navigable": navigable }]}
		data-deck={DECK_BASE}
		data-count={slideCount}
		data-delay={AUTOPLAY_DELAY}
	>
		<div class="deck">
			<div class="track">
				{
					slides.map((slide, slideIndex) => {
						const slot = slotFor(slideIndex);
						return (
							<div class="pane" data-slide={slideIndex} style={`--slot: ${slot}`}>
								<iframe
									src={slideSrc(slide)}
									title={slideIndex === 0 ? "Sophie Matthes — Portfolio" : ""}
									aria-hidden={slideIndex === 0 ? undefined : "true"}
									allowfullscreen
								/>
							</div>
						);
					})
				}
			</div>
		</div>

		<div class="controls">
			<button class="nav" data-step="-1" type="button" aria-label="Vorherige Folie">
				<svg viewBox="0 0 24 24" aria-hidden="true">
					<path d="M16 4 8 12l8 8" />
				</svg>
			</button>
			<button class="nav" data-step="1" type="button" aria-label="Nächste Folie">
				<svg viewBox="0 0 24 24" aria-hidden="true">
					<path d="m8 4 8 8-8 8" />
				</svg>
			</button>
		</div>
	</main>
</Layout>

<style>
	.stage {
		--gap: clamp(0.25rem, 1.5vmin, 1.5rem);
		--reserved: 0px;

		width: 100%;
		padding: var(--frame-padding);
		display: grid;
		grid-template-columns: auto minmax(0, 1fr) auto;
		align-items: center;
		justify-items: center;
		gap: var(--gap);
	}

	.controls {
		display: contents;
	}

	.deck {
		position: relative;
		overflow: hidden;
		grid-column: 2;
		grid-row: 1;
		width: 100%;
		max-width: calc((100vh - 2 * var(--frame-padding) - var(--reserved)) * 16 / 9);
		max-width: calc((100dvh - 2 * var(--frame-padding) - var(--reserved)) * 16 / 9);
		aspect-ratio: 16 / 9;
	}

	.track {
		position: absolute;
		inset: 0;
		transform: translateX(calc(var(--index, 0) * -100%));
		transition: transform 500ms cubic-bezier(0.4, 0, 0.2, 1);
		will-change: transform;
	}

	.pane {
		position: absolute;
		inset-block: 0;
		width: 100%;
		transform: translateX(calc(var(--slot) * 100%));
		background: var(--color-bg);
	}

	.pane iframe {
		display: block;
		width: 100%;
		height: 100%;
		border: 0;
	}

	.nav {
		display: none;
		place-items: center;
		width: clamp(2rem, 5vmin, 4.5rem);
		aspect-ratio: 1 / 2;
		padding: 0;
		border: 0;
		background: none;
		color: var(--color-text);
		cursor: pointer;
		opacity: 0.55;
		transition: opacity 150ms ease;
	}

	.nav:hover,
	.nav:focus-visible {
		opacity: 1;
	}

	.nav svg {
		width: 100%;
		height: auto;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.75;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.stage.is-navigable .nav {
		display: grid;
	}

	.nav[data-step="-1"] {
		grid-column: 1;
		grid-row: 1;
	}

	.nav[data-step="1"] {
		grid-column: 3;
		grid-row: 1;
	}

	@media (pointer: coarse) {
		.stage {
			--nav-size: clamp(2.5rem, 11vmin, 3.5rem);
			--controls-gap: clamp(2rem, 10vmin, 4rem);
			--reserved: calc(var(--nav-size) + var(--controls-gap));

			grid-template-columns: minmax(0, 1fr);
			row-gap: var(--controls-gap);
		}

		.deck {
			grid-column: 1;
		}

		.stage.is-navigable .controls {
			display: flex;
			grid-column: 1;
			grid-row: 2;
			justify-content: center;
			gap: clamp(3rem, 18vmin, 6rem);
		}

		.nav {
			width: var(--nav-size);
			aspect-ratio: 1;
			opacity: 0.75;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.track,
		.nav {
			transition: none;
		}
	}
</style>

<script>
	const stage = document.querySelector<HTMLElement>(".stage");
	const deck = stage?.querySelector<HTMLElement>(".deck");
	const track = deck?.querySelector<HTMLElement>(".track");

	if (stage && deck && track) {
		const base = stage.dataset.deck;
		const delay = Number(stage.dataset.delay);
		const slideSrc = (slide: number) =>
			`${base}?start=false&loop=false&rm=minimal&slide=${slide}`;

		let count = Number(stage.dataset.count);
		let index = 0;
		let handedOver = false;
		let timer = 0;
		let following = 0;

		const position = () => {
			const width = deck.getBoundingClientRect().width;
			if (!width) return index;
			return -new DOMMatrixReadOnly(getComputedStyle(track).transform).m41 / width;
		};

		// Setzt jede Folie auf die Kopie, die der sichtbaren Position am nächsten
		// liegt. Verschoben wird eine Folie erst, wenn sie mehr als eine halbe Runde
		// entfernt ist – also weit außerhalb des Sichtfensters.
		const layout = (at: number) => {
			for (const pane of track.querySelectorAll<HTMLElement>(".pane")) {
				const slide = Number(pane.dataset.slide);
				const slot = slide + count * Math.round((at - slide) / count);
				if (pane.dataset.slot !== String(slot)) {
					pane.dataset.slot = String(slot);
					pane.style.setProperty("--slot", String(slot));
				}
			}
		};

		const follow = () => {
			const at = position();
			layout(at);
			following =
				Math.abs(at - index) > 0.001 ? requestAnimationFrame(follow) : 0;
		};

		const go = (step: number, byUser = false) => {
			if (byUser) handedOver = true;
			if (count < 2) return;

			index += step;
			layout(position());
			track.style.setProperty("--index", String(index));
			if (!following) following = requestAnimationFrame(follow);

			stopAutoplay();
			startAutoplay();
		};

		function startAutoplay() {
			stopAutoplay();
			if (handedOver || count < 2) return;
			timer = window.setInterval(() => go(1), delay);
		}

		function stopAutoplay() {
			window.clearInterval(timer);
		}

		const rebuild = (live: number) => {
			track.replaceChildren(
				...Array.from({ length: live }, (_, slide) => {
					const pane = document.createElement("div");
					pane.className = "pane";
					pane.dataset.slide = String(slide);
					const frame = document.createElement("iframe");
					frame.src = slideSrc(slide + 1);
					frame.allowFullscreen = true;
					if (slide !== 0) frame.setAttribute("aria-hidden", "true");
					pane.append(frame);
					return pane;
				}),
			);
		};

		const applyCount = (live: number) => {
			if (!Number.isInteger(live) || live < 1 || live === count) return;
			count = live;
			index = 0;
			stage.dataset.count = String(live);
			stage.classList.toggle("is-navigable", live > 1);

			rebuild(live);
			track.style.transition = "none";
			track.style.setProperty("--index", "0");
			layout(0);
			void track.offsetWidth;
			track.style.transition = "";

			startAutoplay();
		};

		fetch("/api/slide-count.json")
			.then((res) => (res.ok ? res.json() : null))
			.then((data) => data && applyCount(data.slideCount))
			.catch(() => {});

		startAutoplay();

		stage.addEventListener("pointerenter", stopAutoplay);
		stage.addEventListener("pointerleave", startAutoplay);
		document.addEventListener("visibilitychange", () =>
			document.hidden ? stopAutoplay() : startAutoplay(),
		);

		for (const button of stage.querySelectorAll<HTMLElement>(".nav")) {
			button.addEventListener("click", () =>
				go(Number(button.dataset.step), true),
			);
		}

		document.addEventListener("keydown", (event) => {
			if (event.key === "ArrowLeft") go(-1, true);
			else if (event.key === "ArrowRight") go(1, true);
		});
	}
</script>
