---
import Layout from "../layouts/Layout.astro";

const DECK_BASE =
	"https://docs.google.com/presentation/d/e/2PACX-1vRpjdtg24rsBPwc3FlZcg39QWNcLx2SinTuQ6HcpN-K3czo6iW7JOnHk0oeXIvh0fP4d5GO-g3px-_Q/pubembed";
const AUTOPLAY_DELAY = 10000;

let slideCount = 0;
try {
	const html = await fetch(DECK_BASE).then((res) => res.text());
	slideCount = Number.parseInt(
		html.match(/slidePageCount:\s*([\d.]+)/)?.[1] ?? "0",
		10,
	);
} catch {
	console.warn("Slide count not available – navigation will be hidden.");
}

const slideSrc = (slide: number) =>
	`${DECK_BASE}?start=false&loop=false&rm=minimal&slide=${slide}`;
const navigable = slideCount > 1;
---

<Layout title="Sophie Matthes" description="Portfolio of Sophie Matthes.">
	<main
		class:list={["stage", { "is-navigable": navigable }]}
		data-deck={DECK_BASE}
		data-count={slideCount}
		data-delay={AUTOPLAY_DELAY}
	>
		<div class="deck">
			<div class="pane" data-slide="1">
				<iframe
					src={slideSrc(1)}
					title="Sophie Matthes — Portfolio"
					allowfullscreen></iframe>
			</div>
			<div class="pane pane--offstage">
				<iframe title="" aria-hidden="true"></iframe>
			</div>
		</div>

		<div class="controls">
			<button class="nav" data-step="-1" type="button" aria-label="Vorherige Folie">
				<svg viewBox="0 0 24 24" aria-hidden="true">
					<path d="M16 4 8 12l8 8" />
				</svg>
			</button>
			<button class="nav" data-step="1" type="button" aria-label="Nächste Folie">
				<svg viewBox="0 0 24 24" aria-hidden="true">
					<path d="m8 4 8 8-8 8" />
				</svg>
			</button>
		</div>
	</main>
</Layout>

<style>
	.stage {
		--gap: clamp(0.25rem, 1.5vmin, 1.5rem);
		--reserved: 0px;

		width: 100%;
		padding: var(--frame-padding);
		display: grid;
		grid-template-columns: auto minmax(0, 1fr) auto;
		align-items: center;
		justify-items: center;
		gap: var(--gap);
	}

	.controls {
		display: contents;
	}

	.deck {
		position: relative;
		overflow: hidden;
		grid-column: 2;
		grid-row: 1;
		width: 100%;
		max-width: calc((100vh - 2 * var(--frame-padding) - var(--reserved)) * 16 / 9);
		max-width: calc((100dvh - 2 * var(--frame-padding) - var(--reserved)) * 16 / 9);
		aspect-ratio: 16 / 9;
	}

	.pane {
		position: absolute;
		inset: 0;
		background: var(--color-bg);
		transition: transform 500ms cubic-bezier(0.4, 0, 0.2, 1);
		will-change: transform;
	}

	.pane--offstage {
		transform: translateX(calc(100% + 1px));
	}

	.pane iframe {
		display: block;
		width: 100%;
		height: 100%;
		border: 0;
	}

	.nav {
		display: none;
		place-items: center;
		width: clamp(2rem, 5vmin, 4.5rem);
		aspect-ratio: 1 / 2;
		padding: 0;
		border: 0;
		background: none;
		color: var(--color-text);
		cursor: pointer;
		opacity: 0.55;
		transition: opacity 150ms ease;
	}

	.nav:hover,
	.nav:focus-visible {
		opacity: 1;
	}

	.nav svg {
		width: 100%;
		height: auto;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.75;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.stage.is-navigable .nav {
		display: grid;
	}

	.nav[data-step="-1"] {
		grid-column: 1;
		grid-row: 1;
	}

	.nav[data-step="1"] {
		grid-column: 3;
		grid-row: 1;
	}

	@media (pointer: coarse) {
		.stage {
			--nav-size: clamp(2.5rem, 11vmin, 3.5rem);
			--controls-gap: clamp(2rem, 10vmin, 4rem);
			--reserved: calc(var(--nav-size) + var(--controls-gap));

			grid-template-columns: minmax(0, 1fr);
			row-gap: var(--controls-gap);
		}

		.deck {
			grid-column: 1;
		}

		.stage.is-navigable .controls {
			display: flex;
			grid-column: 1;
			grid-row: 2;
			justify-content: center;
			gap: clamp(3rem, 18vmin, 6rem);
		}

		.nav {
			width: var(--nav-size);
			aspect-ratio: 1;
			opacity: 0.75;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.pane,
		.nav {
			transition: none;
		}
	}
</style>

<script>
	const TRANSITION_MS = 500;

	const stage = document.querySelector<HTMLElement>(".stage");
	const panes = [...(stage?.querySelectorAll<HTMLElement>(".pane") ?? [])];

	if (stage && panes.length === 2) {
		const base = stage.dataset.deck;
		const delay = Number(stage.dataset.delay);
		const slideSrc = (slide: number) =>
			`${base}?start=false&loop=false&rm=minimal&slide=${slide}`;

		let count = Number(stage.dataset.count);
		let active = 0;
		let current = 1;
		let busy = false;
		let handedOver = false;
		let timer = 0;

		const wrap = (slide: number) => ((slide - 1 + count) % count) + 1;

		const flush = (direction: number) => `translateX(${direction > 0 ? 100 : -100}%)`;

		const parked = (direction: number) =>
			`translateX(calc(${direction > 0 ? "100% + 1px" : "-100% - 1px"}))`;

		const snap = (pane: HTMLElement, transform: string) => {
			pane.style.transition = "none";
			pane.style.transform = transform;
			void pane.offsetWidth;
			pane.style.transition = "";
		};

		const loading = new WeakMap<HTMLElement, Promise<void>>();

		const load = (pane: HTMLElement, slide: number) => {
			if (pane.dataset.slide === String(slide)) {
				return loading.get(pane) ?? Promise.resolve();
			}
			pane.dataset.slide = String(slide);
			const frame = pane.querySelector("iframe")!;
			const done = new Promise<void>((resolve) => {
				frame.addEventListener("load", () => resolve(), { once: true });
				frame.src = slideSrc(slide);
			});
			loading.set(pane, done);
			void done.then(() => {
				if (loading.get(pane) === done) loading.delete(pane);
			});
			return done;
		};

		const settled = (pane: HTMLElement) =>
			new Promise<void>((resolve) => {
				const done = () => {
					pane.removeEventListener("transitionend", done);
					clearTimeout(fallback);
					resolve();
				};
				const fallback = setTimeout(done, TRANSITION_MS + 100);
				pane.addEventListener("transitionend", done);
			});

		const go = async (step: number, byUser = false) => {
			if (byUser) handedOver = true;
			if (busy || count < 2) return;
			busy = true;
			stopAutoplay();

			const target = wrap(current + step);
			const incoming = panes[1 - active];
			const outgoing = panes[active];
			await load(incoming, target);

			snap(incoming, flush(step));

			outgoing.style.transform = flush(-step);
			incoming.style.transform = "translateX(0)";
			await settled(incoming);

			snap(outgoing, parked(-step));

			active = 1 - active;
			current = target;
			busy = false;

			void load(panes[1 - active], wrap(current + 1));
			startAutoplay();
		};

		function startAutoplay() {
			stopAutoplay();
			if (handedOver || count < 2) return;
			timer = window.setInterval(() => void go(1), delay);
		}

		function stopAutoplay() {
			window.clearInterval(timer);
		}

		const applyCount = (live: number) => {
			if (!Number.isInteger(live) || live === count) return;
			count = live;
			stage.dataset.count = String(live);
			stage.classList.toggle("is-navigable", live > 1);
			if (current > live) current = 1;
			void load(panes[1 - active], wrap(current + 1));
			startAutoplay();
		};

		fetch("/api/slide-count.json")
			.then((res) => (res.ok ? res.json() : null))
			.then((data) => data && applyCount(data.slideCount))
			.catch(() => {});

		if (count > 1) void load(panes[1], wrap(current + 1));
		startAutoplay();

		stage.addEventListener("pointerenter", stopAutoplay);
		stage.addEventListener("pointerleave", startAutoplay);
		document.addEventListener("visibilitychange", () =>
			document.hidden ? stopAutoplay() : startAutoplay(),
		);

		for (const button of stage.querySelectorAll<HTMLElement>(".nav")) {
			button.addEventListener(
				"click",
				() => void go(Number(button.dataset.step), true),
			);
		}

		document.addEventListener("keydown", (event) => {
			if (event.key === "ArrowLeft") void go(-1, true);
			else if (event.key === "ArrowRight") void go(1, true);
		});

	}
</script>
